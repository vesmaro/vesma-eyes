exports[`Kora workspace snapshots (KW4 «Поле хоста + правая панель») > pins the English frame 1`] = `"<section aria-labelledby="kora-title" class="w-full flex flex-col gap-4 lg:h-[var(--kora-frame-h)] lg:gap-3 lg:overflow-hidden"><div class="shrink-0"><header class="flex flex-wrap items-center gap-x-4 gap-y-2"><h1 id="kora-title" title="Kora — the journal of every host&#x27;s sessions: what the agent did and said. Read-only records" class="text-lg font-semibold">Kora · host sessions</h1><p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tabular-nums text-foreground-secondary"><span>hosts: 2</span><span>running sessions: 1</span><span>in 24h: 2</span></p></header></div><div class="relative grid min-h-0 min-w-0 flex-1 items-start gap-4 lg:grid-cols-[minmax(0,1fr)_var(--kora-right-w)] lg:items-stretch lg:gap-0" style="--kora-right-w:320px"><div class="flex min-h-0 min-w-0 flex-col overflow-hidden rounded-md border border-myelin bg-well lg:rounded-none lg:border-0"><section aria-label="Session run" class="flex min-h-0 min-w-0 flex-1 flex-col px-6 py-5"><p class="text-sm text-foreground-secondary">Pick a session — its run opens here</p></section></div><div role="separator" aria-orientation="vertical" aria-label="Meta panel width" aria-valuemin="240" aria-valuemax="420" aria-valuenow="320" aria-valuetext="320 px" tabindex="0" title="Drag to resize. Double-click to restore" class="group z-20 touch-none select-none items-center justify-center bg-transparent outline-none w-6 cursor-col-resize absolute inset-y-0 left-[calc(100%-var(--kora-right-w))] hidden -translate-x-1/2 lg:flex"><span aria-hidden="true" class="rounded-full transition-[width,height,background-color] duration-instant h-full w-px bg-myelin-hairline group-hover:w-1 group-hover:bg-myelin-strong group-data-[dragging]:w-1 group-data-[dragging]:bg-myelin-strong"></span><span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-sm group-focus-visible:outline group-focus-visibl