exports[`Kora slice-2 list screen snapshots > pins the English screen 1`] = `"<section aria-labelledby="kora-title" class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-center gap-3"><h1 id="kora-title" class="text-xl font-semibold">Kora — sessions across all hosts</h1><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary gap-1" title="Kora currently shows demo data: the lists and transcripts are samples, not live sessions. Real sessions will appear once the host scanner starts."><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Demo data</span></div><h2 class="text-lg font-semibold">Sessions</h2><ul class="space-y-3"><li><a class="group flex flex-col gap-2 rounded-md border border-border-subtle p-4 transition-colors hover:bg-well focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/kora/exec-zcode-main%3Asess_7f3a91" data-discover="true"><div class="flex flex-wrap items-center gap-2"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-success-tint text-success"></span><span class="font-mono text-sm">zcode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">live</span><span class=