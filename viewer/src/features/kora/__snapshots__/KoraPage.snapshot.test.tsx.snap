lass="flex min-h-12 md:min-h-6 w-full items-center gap-1.5 rounded-sm text-left text-xs font-semibold uppercase tracking-wide text-foreground-secondary transition-colors duration-instant hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright">▸<!-- --> <!-- -->Digest</button></section><section aria-label="Ether"><button type="button" aria-expanded="true" aria-controls="kora-meta-ether-body" class="flex min-h-12 md:min-h-6 w-full items-center gap-1.5 rounded-sm text-left text-xs font-semibold uppercase tracking-wide text-foreground-secondary transition-colors duration-instant hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright">▾<!-- --> <!-- -->Ether</button><div id="kora-meta-ether-body" class="mt-2 space-y-2 text-sm"><div class="min-w-0 flex flex-col"><p class="text-xs uppercase tracking-wide text-foreground-muted">Ether — everything happening in the sessions right now</p><p class="mt-2 text-sm text-foreground-secondary">No events yet — the feed collects what happens in the sessions while you are here</p></div></div></section><section aria-label="What we see from your machines"><button type="button" aria-expanded="false" aria-controls="kora-legend-body" class="flex min-h-12 md:min-h-6 w-full items-center gap-1.5 rounded-sm text-left text-xs font-semibold uppercase tracking-wide text-foreground-secondary transition-colors duration-instant hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright">▸<!-- --> <!-- -->What we see from your machines</button></section></div></aside></div></section>"`;

exports[`Kora workspace snapshots (KW4 «Поле хоста + правая панель») > pins the two-zone frame: header + invitation + «Дерево и мета» panel, ONE seam (ru) 1`] = `"<section aria-labelledby="kora-title" class="w-full flex flex-col gap-4 lg:h-[var(--kora-frame-h)] lg:gap-3 lg:overflow-hidden"><div class="shrink-0"><header class="flex flex-wrap items-center gap-x-4 gap-y-2"><h1 id="kora-title" title="Кора — журнал сессий всех хостов: что агент делал и что говорил. Записи только для чтения" class="text-lg font-semibold">Кора · сессии хостов</h1><p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tabular-nums text-foreground-secondary"><span>хостов: 2</span><span>идёт сессий: 1</span><span>за 24 ч: 2</span></p></header></div><div class="relative grid min-h-0 min-w-0 flex-1 items-start gap-4 lg:grid-cols-[minmax(0,1fr)_var(--kora-right-w)] lg:items-stretch lg:gap-0" style="--kora-right-w:320px"><div class="flex min-h-0 min-w-0 flex-col overflow-hidden rounded-md border border-myelin bg-well lg:rounded-none lg:border-0"><section aria-label="Ход сессии" class="flex min-h-0 min-w-0 flex-1 flex-col px-6 py-5"><p class="text-sm text-foreground-secondary">Выберите сессию — здесь откроется её ход</p></section></div><div role="separator" aria-orientation="vertical" aria-label="Ширина мета-панели" aria-valuemin="240" aria-valuemax="420" aria-valuenow="320" aria-valuetext="320 px" tabindex="0" title="Потяните, чтобы изменить ширину. Двойной клик — вернуть как было" class="group z-20 touch-none select-none items-center justify-center bg-transparent outline-none w-6 cursor-col-resize absolute inset-y-0 left-[calc(100%-var(--kora-right-w))] hidden -translate-x-1/2 lg:flex"><span aria-hidden="true" class="rounded-full transition-[width,height,background-color] duration-instant h-full w-px bg-myelin-hairline group-hover:w-1 group-hover:bg-myelin-strong group-data-[dragging]:w-1 group-data-[dragging]:bg-myelin-strong"></span><span aria-hidden="true" class="pointer-even